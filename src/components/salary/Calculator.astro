---
/**
 * The salary calculator island.
 *
 * Built from the shared calculator parts in src/components/calc. The browser
 * gets SALARY_PARAMS serialised into the page and runs the same pure
 * functions as the server, so the data file never reaches the client.
 */
import type { Locale } from "../../i18n/config.ts";
import { useTranslations } from "../../i18n/utils.ts";
import { SALARY_PARAMS, calculateNetSalary } from "../../lib/salary.ts";
import { salaryCopyParams } from "../../lib/salary-copy.ts";
import { renderResult } from "../../lib/salary-view.ts";
import { formatAmount } from "../../lib/format.ts";
import CalcShell from "../calc/CalcShell.astro";
import AmountField from "../calc/AmountField.astro";
import CheckField from "../calc/CheckField.astro";
import SelectField from "../calc/SelectField.astro";
import ResultPanel from "../calc/ResultPanel.astro";

interface Props {
  locale: Locale;
  /** Salary shown before the visitor types anything. */
  defaultGross?: number;
}

const { locale, defaultGross = 300_000 } = Astro.props;

const t = useTranslations(locale);
const copy = salaryCopyParams(locale);
const c = (key: string) => t(`pages.salary.calculator.${key}`, copy);

const labels = { exempt: c("exempt"), capNote: c("capNote") };
const initial = renderResult(calculateNetSalary({ gross: defaultGross }), locale, labels);

const lineLabels = Object.fromEntries(
  initial.lines.map((line) => [line.key, c(`deductions.${line.key}`)]),
);

// Serialised for the browser: a few numbers, not the data file.
const config = { params: SALARY_PARAMS, locale, labels };
---

<CalcShell legend={c("legend")} name="salary" config={config}>
  <AmountField
    id="gross"
    input="gross"
    label={c("grossLabel")}
    hint={c("grossHint")}
    value={formatAmount(defaultGross, locale)}
  />
  <CheckField
    id="pension"
    input="pension"
    label={c("pensionLabel")}
    hint={c("pensionHint")}
    checked
  />
  <SelectField
    id="regime"
    input="regime"
    label={c("regimeLabel")}
    hint={c("regimeHint")}
    options={[
      { value: "standard", label: c("regimeStandard") },
      { value: "rd", label: c("regimeRd") },
    ]}
  />

  <ResultPanel
    slot="result"
    heading={c("resultHeading")}
    resultLabel={c("netLabel")}
    baseLabel={c("grossSummary")}
    totalLabel={c("totalLabel")}
    lineLabels={lineLabels}
    initial={initial}
  />
</CalcShell>

<script>
  import { calculateNetSalary, type SalaryParams } from "../../lib/salary-core.ts";
  import { renderResult } from "../../lib/salary-view.ts";
  import type { FormulaLabels } from "../../lib/breakdown.ts";
  import type { Locale } from "../../i18n/config.ts";
  import {
    amountReader,
    applyBreakdown,
    inputOf,
    mountIslands,
    onAnyInput,
  } from "../../scripts/calc-island.ts";

  interface Config {
    params: SalaryParams;
    locale: Locale;
    labels: FormulaLabels;
  }

  mountIslands<Config>("salary", (root, config) => {
    const gross = amountReader(inputOf(root, "gross"), config.locale);
    const pension = inputOf(root, "pension");
    const regime = inputOf<HTMLSelectElement>(root, "regime");

    onAnyInput(root, () => {
      const result = calculateNetSalary(config.params, {
        gross: gross(),
        pensionParticipant: pension.checked,
        regime: regime.value === "rd" ? "rd" : "standard",
      });
      applyBreakdown(root, renderResult(result, config.locale, config.labels));
    });
  });
</script>
