---
/**
 * The salary calculator page: the shared calculator page with the salary
 * island, its worked examples and its sources.
 */
import type { Locale } from "../../i18n/config.ts";
import { useTranslations } from "../../i18n/utils.ts";
import { calculateNetSalary } from "../../lib/salary.ts";
import { EXAMPLE_SALARIES, salaryCopyParams } from "../../lib/salary-copy.ts";
import { LAST_VERIFIED, SALARY_SOURCES } from "../../lib/salary-sources.ts";
import { formatAmd } from "../../lib/format.ts";
import { renderResult } from "../../lib/salary-view.ts";
import CalculatorPage from "./CalculatorPage.astro";
import Calculator from "../salary/Calculator.astro";

interface Props {
  locale: Locale;
  pageKey: string;
}

const { locale, pageKey } = Astro.props;

const tt = useTranslations(locale);
const copy = salaryCopyParams(locale);
const c = (key: string) => tt(`pages.salary.calculator.${key}`, copy);

const lineLabels = Object.fromEntries(
  (["incomeTax", "pension", "stamp", "health"] as const).map((key) => [
    key,
    c(`deductions.${key}`),
  ]),
);

// Worked examples run through the same code as the calculator, so the page
// cannot quote a figure the calculator would not produce.
const formulaLabels = { exempt: c("exempt"), capNote: c("capNote") };
const examples = EXAMPLE_SALARIES.map((gross) => ({
  label: tt("pages.salary.examples.caseLabel", { ...copy, gross: formatAmd(gross, locale) }),
  result: renderResult(calculateNetSalary({ gross }), locale, formulaLabels),
}));

const sources = SALARY_SOURCES.map((source) => ({
  label:
    source.labelKey === "minimumWage"
      ? tt("pages.salary.sources.minimumWage", copy)
      : lineLabels[source.labelKey]!,
  name: source.sourceName,
  url: source.sourceUrl,
  effectiveFrom: source.effectiveFrom,
  evidence: source.evidence,
}));
---

<CalculatorPage
  locale={locale}
  pageKey={pageKey}
  ns="salary"
  copy={copy}
  examples={examples}
  lineLabels={lineLabels}
  sources={sources}
  lastVerified={LAST_VERIFIED}
>
  <Calculator locale={locale} />
</CalculatorPage>
