---
/**
 * Home page for every locale: /ru/, /hy/, /en/.
 *
 * One file serves all three; the locale comes from the route parameter, and
 * all text comes from src/i18n/locales/*.json.
 */
import { LOCALES, type Locale } from "../../i18n/config.ts";
import { HOME_KEY, calculatorRoutes, calculatorsIn, pathFor, routesOfKind } from "../../i18n/routes.ts";
import { useTranslations } from "../../i18n/utils.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalculatorCards from "../../components/CalculatorCards.astro";
import JsonLd from "../../components/JsonLd.astro";
import LinkList from "../../components/LinkList.astro";
import Tag from "../../components/ui/Tag.astro";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);

const site = Astro.site ?? new URL("http://localhost:4321");

// Every calculator, one click away, grouped under its category.
const categories = routesOfKind("category");

const project = ["about", "methodology"].map((key) => ({
  label: t(`pages.${key}.breadcrumb`),
  href: pathFor(key, locale),
  note: t(`pages.${key}.summary`),
}));

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: t("site.name"),
  description: t("pages.home.description"),
  url: new URL(pathFor(HOME_KEY, locale), site).href,
  inLanguage: locale,
};

const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: calculatorRoutes()
    .filter((r) => r.enabled)
    .map((r, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: t(`calculators.${r.key}.name`),
      url: new URL(pathFor(r.key, locale), site).href,
    })),
};
---

<BaseLayout
  locale={locale}
  pageKey={HOME_KEY}
  title={`${t("pages.home.title")} — ${t("site.name")}`}
  description={t("pages.home.description")}
>
  <Fragment slot="head">
    <JsonLd schema={websiteSchema} />
    <JsonLd schema={listSchema} />
  </Fragment>

  <section class="hero">
    <Tag variant="inline">{t("site.tagline")}</Tag>
    <h1>{t("pages.home.heading")}</h1>
    <p class="intro">{t("pages.home.intro")}</p>
  </section>

  {
    categories.map((category) => (
      <section class="group" aria-labelledby={`cat-${category.key}`}>
        <div class="group-head">
          <h2 id={`cat-${category.key}`}>{t(`pages.${category.key}.breadcrumb`)}</h2>
          <a class="all" href={pathFor(category.key, locale)}>
            {t("pages.home.categoryLink")}
          </a>
        </div>
        <CalculatorCards locale={locale} routes={calculatorsIn(category.key)} />
      </section>
    ))
  }

  <section class="about reveal" aria-labelledby="about">
    <h2 id="about">{t("pages.home.aboutHeading")}</h2>
    <p>{t("pages.home.aboutText")}</p>
    <LinkList items={project} />
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
    padding-block: var(--spacing-60) var(--spacing-40);
  }

  .hero h1 {
    /* Mobile-first: the 60px display size comes in at wider viewports. */
    font-size: var(--text-heading);
    line-height: var(--text-heading--line-height);
  }

  .intro {
    max-width: 52ch;
    color: var(--color-graphite);
  }

  .group + .group {
    margin-top: var(--spacing-40);
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-8) var(--spacing-16);
    margin-bottom: var(--spacing-16);
  }

  h2 {
    font-size: var(--text-subheading);
    line-height: var(--text-subheading--line-height);
  }

  .all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-medium);
    text-underline-offset: 3px;
  }

  .all:hover {
    color: var(--color-graphite);
  }

  .about {
    margin-top: var(--section-gap-min);
  }

  .about > p {
    margin-top: var(--spacing-16);
    max-width: 62ch;
    color: var(--color-graphite);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--spacing-80) var(--spacing-60);
    }

    .hero h1 {
      font-size: var(--text-heading-lg);
      line-height: var(--text-heading-lg--line-height);
    }

    .group + .group {
      margin-top: var(--spacing-60);
    }

    h2 {
      font-size: var(--text-heading);
      line-height: var(--text-heading--line-height);
      letter-spacing: var(--text-heading--letter-spacing);
    }
  }
</style>
